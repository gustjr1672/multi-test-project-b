@page
@model ZeroDowntimeApi.pages.IndexModel
@{
}

<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>Project-B 무중단 배포 테스트 대시보드</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; text-align: center; margin-top: 100px; }
        .btn { display: inline-block; padding: 15px 30px; margin: 10px; font-size: 18px; text-decoration: none; color: white; border-radius: 8px; }
        .btn-blue { background-color: #007bff; }
        .btn-green { background-color: #28a745; }
        .btn-purple { background-color: #a728a3; }

        /* 라이브 배지 */
        #liveBadge {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            margin: 0 auto 30px;
            padding: 12px 22px;
            border-radius: 999px;
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            font-size: 14px;
            color: #333;
        }
        #liveBadge .dot {
            width: 12px; height: 12px; border-radius: 50%;
            background: #adb5bd; /* 기본 회색(미확인) */
        }
        #liveBadge.up .dot   { background: #28a745; box-shadow: 0 0 0 4px rgba(40,167,69,.2); }
        #liveBadge.down .dot { background: #dc3545; box-shadow: 0 0 0 4px rgba(220,53,69,.2); }
        #liveBadge .color-blue  { color: #007bff; font-weight: bold; }
        #liveBadge .color-green { color: #28a745; font-weight: bold; }
        #liveBadge code { background: #e9ecef; padding: 2px 6px; border-radius: 4px; }
    </style>
</head>
<body>
    <h1>Project-B API 테스트 대시보드</h1>

    <!-- ⭐ 라이브 상태 배지: /health 를 2초마다 폴링하여 서비스 생존 여부만 표시 (배포 메타정보는 보안상 비노출) -->
    <div id="liveBadge">
        <span class="dot"></span>
        <span id="liveText">상태 확인 중...</span>
    </div>

    <div>
        <a href="/delayed" class="btn btn-blue"> 지연 버전</a>
        <a href="/quick" class="btn btn-green"> 즉시 버전</a>
        <a href="/loopQuick" class="btn btn-purple"> 반복호출 버전</a>
    </div>

    <script>
        const badge = document.getElementById('liveBadge');
        const liveText = document.getElementById('liveText');

        async function pollHealth() {
            try {
                const res = await fetch('/health', { cache: 'no-store' });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                badge.className = 'up';
                liveText.innerText = '🟢 LIVE';
            } catch (e) {
                badge.className = 'down';
                liveText.innerText = '🔴 응답 없음 (' + e.message + ')';
            }
        }

        pollHealth();
        setInterval(pollHealth, 2000);
    </script>
</body>
</html>

