@page
@model ZeroDowntimeApi.pages.quickModel
@{
}
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>연속 API 스트레스 테스트</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            max-width: 750px;
            margin: 40px auto;
            padding: 0 20px;
            color: #333;
        }

        .nav-link {
            display: inline-block;
            margin-bottom: 20px;
            color: #007bff;
            text-decoration: none;
            font-weight: bold;
        }

        .control-panel {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #dee2e6;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .status-board {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 20px;
            width: 100%;
        }

        .status-card {
            background: #fff;
            padding: 15px;
            border-radius: 6px;
            text-align: center;
            border: 1px solid #ced4da;
        }

            .status-card.success {
                border-left: 5px solid #28a745;
            }

            .status-card.failure {
                border-left: 5px solid #dc3545;
            }

            .status-card.progress-info {
                border-left: 5px solid #007bff;
            }

        .count-num {
            font-size: 24px;
            font-weight: bold;
            margin-top: 5px;
        }

        input[type="number"] {
            padding: 8px;
            width: 80px;
            border-radius: 4px;
            border: 1px solid #ced4da;
        }

        button {
            padding: 10px 20px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            color: white;
            border: none;
            border-radius: 4px;
            transition: background 0.2s;
        }

        #btnStart {
            background-color: #007bff;
        }

            #btnStart:hover {
                background-color: #0056b3;
            }

        /* ⭐️ 중지 버튼 전용 빨간색 스타일 선언 */
        #btnStop {
            background-color: #dc3545;
        }

            #btnStop:hover {
                background-color: #bd2130;
            }

        button:disabled {
            background-color: #6c757d !important;
            cursor: not-allowed;
        }

        .log-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 30px;
        }

        pre {
            background: #1e1e1e;
            color: #d4d4d4;
            padding: 15px;
            border-radius: 6px;
            overflow-y: auto;
            height: 400px;
            font-family: 'Consolas', monospace;
            font-size: 13px;
            line-height: 1.5;
        }

        .version-text {
            color: #f1c40f;
            font-weight: bold;
        }

        /* 컨트롤러 본문이 실어주는 Version 값 표시용 */
        .ctrl-version {
            color: #9b59b6;
            font-weight: bold;
        }

        /* 지연시간 패널 */
        .latency-panel {
            margin-top: 25px;
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 15px;
        }

        .latency-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-bottom: 12px;
            text-align: center;
            color: #666;
            font-size: 13px;
        }

        .lat-num {
            font-size: 20px;
            font-weight: bold;
            color: #333;
            margin-top: 4px;
        }

        #latChart {
            width: 100%;
            display: block;
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <a href="/" class="nav-link">⬅️ 메인으로 돌아가기</a>
    <h2>⚡ 연속 API 무중단 배포 검증 테스트 (제어 센터)</h2>
    <p>요청 횟수를 지정하여 연속 호출하고, 배포 중에도 실패 없이(무중단) 처리되는지 성공/실패 수와 응답시간으로 확인합니다.</p>

    <div class="control-panel">
        <div>
            <label style="font-weight: bold;">User ID: </label>
            <input type="number" id="userId" value="1">
        </div>

        <div>
            <label style="font-weight: bold; margin-left: 10px;">반복 횟수: </label>
            <input type="number" id="requestCount" value="100" min="1" max="10000">
        </div>

        <button id="btnStart" onclick="runStressTest()" style="margin-left: 10px;">🚀 테스트 시작</button>
        <button id="btnStop" onclick="stopStressTest()" disabled style="margin-left: 5px;">⏱️ 테스트 중지</button>

        <div class="status-board">
            <div class="status-card progress-info">
                <div>진행률</div>
                <div class="count-num" id="progressArea">0 / 0</div>
            </div>
            <div class="status-card success">
                <div style="color: #28a745;">성공 (200)</div>
                <div class="count-num" id="successCount" style="color: #28a745;">0</div>
            </div>
            <div class="status-card failure">
                <div style="color: #dc3545;">실패 / 에러</div>
                <div class="count-num" id="failureCount" style="color: #dc3545;">0</div>
            </div>
        </div>
    </div>

    <!-- ⭐ 지연시간(latency) 통계 + 스파크라인: 전환 순간의 순간 지연 스파이크를 정량 확인 -->
    <div class="latency-panel">
        <div class="latency-stats">
            <div class="latency-stat"><div>최소</div><div class="lat-num" id="latMin">- ms</div></div>
            <div class="latency-stat"><div>평균</div><div class="lat-num" id="latAvg">- ms</div></div>
            <div class="latency-stat"><div>최대</div><div class="lat-num" id="latMax">- ms</div></div>
            <div class="latency-stat"><div>최근</div><div class="lat-num" id="latLast">- ms</div></div>
        </div>
        <canvas id="latChart" height="80"></canvas>
        <div style="margin-top: 8px; font-size: 12px; color: #666;">
            <span style="color:#007bff;">▬</span> 응답시간(ms)
        </div>
    </div>

    <div class="log-header">
        <h3 style="margin: 0;">실시간 호출 로그</h3>
        <button onclick="clearLog()" style="padding: 6px 12px; font-size: 13px; background-color: #6c757d;">🗑️ 로그 지우기</button>
    </div>
    <pre id="logArea">대기 중... 테스트 시작 버튼을 누르면 실시간 로그가 출력됩니다.</pre>

    <script>
        // ⭐️ 글로벌 제어용 중지 플래그 선언
        let shouldStop = false;

        // ⭐ 지연시간 추적용 상태
        const latencies = [];          // 전체 응답시간(ms) 누적 (min/avg/max 계산)
        let latSum = 0, latMin = Infinity, latMax = 0;
        const latWindow = [];          // 스파크라인에 그릴 최근 N개
        const LAT_WINDOW_SIZE = 120;

        function resetLatency() {
            latencies.length = 0; latWindow.length = 0;
            latSum = 0; latMin = Infinity; latMax = 0;
            document.getElementById('latMin').innerText = '- ms';
            document.getElementById('latAvg').innerText = '- ms';
            document.getElementById('latMax').innerText = '- ms';
            document.getElementById('latLast').innerText = '- ms';
            drawLatChart();
        }

        function recordLatency(ms) {
            latencies.push(ms);
            latSum += ms;
            if (ms < latMin) latMin = ms;
            if (ms > latMax) latMax = ms;

            latWindow.push(ms);
            if (latWindow.length > LAT_WINDOW_SIZE) {
                latWindow.shift();
            }

            const avg = latSum / latencies.length;
            document.getElementById('latMin').innerText = Math.round(latMin) + ' ms';
            document.getElementById('latAvg').innerText = Math.round(avg) + ' ms';
            document.getElementById('latMax').innerText = Math.round(latMax) + ' ms';
            document.getElementById('latLast').innerText = Math.round(ms) + ' ms';
            drawLatChart();
        }

        function drawLatChart() {
            const canvas = document.getElementById('latChart');
            const ctx = canvas.getContext('2d');
            // 캔버스 실제 픽셀 크기를 표시 너비에 맞춤(선명도)
            const w = canvas.clientWidth || 700;
            const h = canvas.height;
            if (canvas.width !== w) canvas.width = w;
            ctx.clearRect(0, 0, w, h);

            if (latWindow.length === 0) return;

            const max = Math.max(...latWindow, 1);
            const stepX = w / Math.max(latWindow.length - 1, 1);
            const pad = 6;

            // 지연시간 선그래프
            ctx.strokeStyle = '#007bff';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            latWindow.forEach((v, i) => {
                const x = i * stepX;
                const y = h - pad - (v / max) * (h - pad * 2);
                i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
            });
            ctx.stroke();
        }

        function clearLog() {
            document.getElementById('logArea').innerHTML = '대기 중...';
        }

        // ⭐️ 중지 버튼 클릭 시 호출되는 함수
        function stopStressTest() {
            shouldStop = true;
            const btnStop = document.getElementById('btnStop');
            btnStop.disabled = true;
            btnStop.innerText = "중지 요청됨...";
        }

        async function runStressTest() {
            const id = document.getElementById('userId').value;
            const totalRequests = parseInt(document.getElementById('requestCount').value, 10) || 100;

            const btnStart = document.getElementById('btnStart');
            const btnStop = document.getElementById('btnStop');
            const logArea = document.getElementById('logArea');
            const progressArea = document.getElementById('progressArea');
            const successArea = document.getElementById('successCount');
            const failureArea = document.getElementById('failureCount');

            // ⭐️ 시작할 때 중지 플래그 초기화 및 버튼 토글
            shouldStop = false;
            btnStart.disabled = true;
            btnStart.innerText = "테스트 진행 중...";
            btnStop.disabled = false;
            btnStop.innerText = "⏱️ 테스트 중지";

            logArea.innerHTML = '';

            let successCount = 0;
            let failureCount = 0;

            resetLatency();
            progressArea.innerText = `0 / ${totalRequests}`;
            successArea.innerText = "0";
            failureArea.innerText = "0";

            logArea.innerHTML += `🚀 [시작] 총 ${totalRequests}회 연속 테스트를 가동합니다.\n\n`;

            for (let i = 1; i <= totalRequests; i++) {
                // ⭐️ 매 루프의 시작점마다 중지 요청이 들어왔는지 확인
                if (shouldStop) {
                    logArea.innerHTML += `\n🛑 [중지] 사용자에 의해 테스트가 강제 중지되었습니다.\n`;
                    break;
                }

                const timestamp = new Date().toLocaleTimeString('ko-KR', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit', fractionalSecondDigits: 3 });

                const t0 = performance.now();
                try {
                    // no-store: 매 호출이 캐시 없이 실제 live 컨테이너에 도달하도록 (전환 감지 정확도)
                    const response = await fetch(`/api/User/quick/${id}`, { cache: 'no-store' });
                    const latency = performance.now() - t0;

                    if (response.ok) {
                        // 컨트롤러가 본문에 실어주는 Version 라벨만 표시.
                        // (color@tag·deployId 등 배포 메타와 헤더 기반 스위칭 추적은 보안상 제거됨)
                        let version = '';
                        try {
                            const body = await response.json();
                            version = body.version || body.Version || '';
                        } catch (_) { /* 본문 파싱 실패는 무시 */ }

                        successCount++;
                        recordLatency(latency);

                        const idLog = version ? `<span class="ctrl-version">{${version}}</span>` : '';
                        logArea.innerHTML += `[${timestamp}] [#${String(i).padStart(3, '0')}] ✅ 성공 (${Math.round(latency)}ms) ${idLog}\n`;
                    } else {
                        failureCount++;
                        recordLatency(latency);
                        logArea.innerHTML += `[${timestamp}] [#${String(i).padStart(3, '0')}] <span style="color: #ff5555;">❌ 실패 (HTTP ${response.status}, ${Math.round(latency)}ms)</span>\n`;
                    }
                } catch (error) {
                    const latency = performance.now() - t0;
                    failureCount++;
                    recordLatency(latency);
                    logArea.innerHTML += `[${timestamp}] [#${String(i).padStart(3, '0')}] <span style="color: #ff5555;">💥 에러 발생 (${Math.round(latency)}ms): ${error.message}</span>\n`;
                }

                progressArea.innerText = `${i} / ${totalRequests}`;
                successArea.innerText = successCount;
                failureArea.innerText = failureCount;

                logArea.scrollTop = logArea.scrollHeight;

                await new Promise(resolve => setTimeout(resolve, 50));
            }

            // 모든 테스트가 끝나거나 중간에 break 되었을 때 UI 복구
            if (!shouldStop) {
                logArea.innerHTML += `\n🏁 [종료] 모든 지정 횟수 호출이 완료되었습니다.\n`;
            }

            btnStart.innerText = "🚀 테스트 시작";
            btnStart.disabled = false;
            btnStop.disabled = true; // 대기 상태일 때는 중지 버튼 비활성화
            btnStop.innerText = "⏱️ 테스트 중지";
        }
    </script>
</body>
</html>